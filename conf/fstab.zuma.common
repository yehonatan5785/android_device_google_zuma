# Android fstab file.
#
# The filesystem containing the filesystem checker binary (typically /system)
# cannot specify MF_CHECK and must appear before any MF_CHECK-enabled filesystems.
#
# Dual entries (ext4 + erofs) allow dynamic selection based on build configuration
# (e.g., BoardConfig.mk). The first successful mount attempt will be used.
#
#<src>                                                  <mnt_point>          <type>  <mnt_flags and options>       <fs_mgr_flags>

# Primary system entries (attempted first)
system                                                  /system              ext4    noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
system                                                  /system              erofs   noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128

# Compliance testing fallback (GSI typically uses ext4)
# Previous entries would fail for GSIs, so these act as fallbacks
system                                                  /system              ext4    noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
system                                                  /system              erofs   noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128

system_dlkm                                             /system_dlkm         ext4    noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,avb_keys=no_such_key,logical,first_stage_mount,readahead_size_kb=128
system_dlkm                                             /system_dlkm         erofs   noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,avb_keys=no_such_key,logical,first_stage_mount,readahead_size_kb=128

system_ext                                              /system_ext          ext4    noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
system_ext                                              /system_ext          erofs   noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128

product                                                 /product             ext4    noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128
product                                                 /product             erofs   noatime,lazytime,ro           wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128

vendor                                                  /vendor              ext4    noatime,lazytime,ro           wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount,readahead_size_kb=128
vendor                                                  /vendor              erofs   noatime,lazytime,ro           wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount,readahead_size_kb=128

vendor_dlkm                                             /vendor_dlkm         ext4    noatime,lazytime,ro           wait,slotselect,avb=vbmeta,avb_keys=no_such_key,logical,first_stage_mount
vendor_dlkm                                             /vendor_dlkm         erofs   noatime,lazytime,ro           wait,slotselect,avb=vbmeta,avb_keys=no_such_key,logical,first_stage_mount

# Static partitions (fixed filesystem types)
/dev/block/platform/13200000.ufs/by-name/boot           /boot                emmc    defaults                       slotselect,avb=boot,first_stage_mount
/dev/block/platform/13200000.ufs/by-name/init_boot      /init_boot           emmc    defaults                       slotselect,avb=init_boot,first_stage_mount
/dev/block/platform/13200000.ufs/by-name/misc           /misc                emmc    defaults                       wait
#/dev/block/platform/13200000.ufs/by-name/pvmfw         /pvmfw               emmc    defaults                       wait,slotselect,avb=pvmfw,first_stage_mount
/dev/block/platform/13200000.ufs/by-name/vbmeta         /vbmeta              emmc    defaults                       slotselect,first_stage_mount

# Dynamic devices
/devices/platform/11210000.usb*                         auto                 vfat    defaults                       voldmanaged=usb:auto
